---
import { execSync } from 'node:child_process';
import type { CollectionEntry } from 'astro:content';

interface Props { site: CollectionEntry<'site'>['data']; lang: string }
const { site, lang } = Astro.props;

// The live line: when this page was built and from which commit. In CI the env vars are set.
const builtAt = new Date().toISOString();
let sha = process.env.GITHUB_SHA ?? '';
if (!sha) try { sha = execSync('git rev-parse HEAD', { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch {}
const repo = 'https://github.com/MurabitoF/portfolio-v3';
const runUrl = process.env.GITHUB_RUN_ID ? `${repo}/actions/runs/${process.env.GITHUB_RUN_ID}` : undefined;
---
<section class="hero">
  <header class="bar">
    <a class="mark" href={lang === 'en' ? '/' : '/es/'}>{site.name}</a>
    <nav class="links">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="icon-link" href={site.switchLocale.href} hreflang={site.switchLocale.lang} lang={site.switchLocale.lang} aria-label={site.switchLocale.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z" /></svg>
        <span aria-hidden="true">{site.switchLocale.lang.toUpperCase()}</span>
      </a>
      <button class="theme" type="button" data-theme-toggle data-to-dark={site.theme.toDark} data-to-light={site.theme.toLight} aria-label={site.theme.toLight}>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
      </button>
    </nav>
  </header>

  <h1>{site.name.split(' ').map((word) => <span>{word}</span>)}</h1>
  <div class="row">
    <p class="lede">{site.lede}</p>
    <a class="btn" href={site.cv.href} download>{site.cv.label}</a>
  </div>
  <p class="deploy">
    <a href={runUrl ?? repo}>{site.deploy.label} <time datetime={builtAt} data-relative>{builtAt.slice(0, 10)}</time></a>
    {sha && <> · <a href={`${repo}/commit/${sha}`}>{site.deploy.commit} {sha.slice(0, 7)}</a></>}
  </p>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto auto auto;
    padding: 0 var(--margin) 48px;
  }
  .bar { display: flex; justify-content: space-between; align-items: baseline; padding-top: 24px; font-size: var(--step-small); }
  .mark { font-weight: 600; }
  .links { display: flex; gap: 28px; align-items: baseline; color: var(--muted); }
  .links a, .theme { transition: color 160ms var(--ease-out); }
  .links a:hover, .theme:hover { color: var(--ink); }
  .theme { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; align-self: center; display: grid; }
  .icon-link { display: inline-flex; gap: 6px; align-items: center; align-self: center; }
  svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  /* the icon shows the theme you switch to */
  .theme .sun, .theme[data-current='light'] .moon { display: block; }
  .theme .moon, .theme[data-current='light'] .sun { display: none; }

  h1 {
    grid-row: 3;
    font-weight: 600; font-size: var(--step-display);
    line-height: 0.88; letter-spacing: -0.045em;
    margin-bottom: 40px;
  }
  h1 span { display: block; }
  .row { grid-row: 4; display: flex; justify-content: space-between; align-items: end; gap: 32px; }
  .lede { max-width: 34ch; font-size: var(--step-lead); line-height: 1.3; }
  .btn { flex: none; }
  .deploy { grid-row: 5; margin-top: 40px; color: var(--muted); font-size: var(--step-small); font-variant-numeric: tabular-nums; }
  .deploy a:hover { color: var(--ink); }

  @media (max-width: 760px) {
    .links a:not([hreflang]) { display: none; }
    .row { flex-direction: column; align-items: start; }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
  const label = () => {
    toggle.dataset.current = current();
    toggle.ariaLabel = current() === 'dark' ? toggle.dataset.toLight! : toggle.dataset.toDark!;
    toggle.title = toggle.ariaLabel;
  };
  label();
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', label);
  toggle.addEventListener('click', () => {
    root.dataset.theme = current() === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    label();
  });

  // "Deployed 3 hours ago", in the page's language.
  const time = document.querySelector<HTMLTimeElement>('[data-relative]');
  if (time) {
    const rtf = new Intl.RelativeTimeFormat(root.lang, { numeric: 'auto' });
    const s = (Date.parse(time.dateTime) - Date.now()) / 1000;
    const [value, unit] = Math.abs(s) < 3600 ? [s / 60, 'minute'] : Math.abs(s) < 86400 ? [s / 3600, 'hour'] : [s / 86400, 'day'];
    time.textContent = rtf.format(Math.round(value), unit as Intl.RelativeTimeFormatUnit);
  }
</script>
