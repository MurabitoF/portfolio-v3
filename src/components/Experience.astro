---
import type { CollectionEntry } from 'astro:content';

interface Props { site: CollectionEntry<'site'>['data'] }
const { experience } = Astro.props.site;
---
<section class="section" id="experience" aria-labelledby="experience-heading">
  <h2 class="section-heading" id="experience-heading">{experience.heading}</h2>
  <ol class="jobs">
    {experience.items.map((job) => (
      <li class="cols">
        <div>
          <h3 class="item-title">{job.company}</h3>
          <p class="role">{job.role}</p>
          <p class="period">{job.period}</p>
        </div>
        <div>
          <p>{job.summary}</p>
          <ul class="highlights">{job.highlights.map((item) => <li>{item}</li>)}</ul>
          <ul class="tags">{job.stack.map((tech) => <li>{tech}</li>)}</ul>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .jobs { list-style: none; padding: 0; display: grid; gap: clamp(56px, 6vw, 88px); }
  .role { margin-top: 8px; }
  .period { color: var(--muted); margin-top: 4px; font-variant-numeric: tabular-nums; }
  .highlights { margin-top: 16px; padding-left: 1.1em; display: grid; gap: 8px; }
  .highlights li::marker { color: var(--muted); }
  .tags { margin-top: 20px; }
</style>
