---
import type { CollectionEntry } from 'astro:content';

interface Props { site: CollectionEntry<'site'>['data'] }
const { about } = Astro.props.site;
---
<section class="about section" id="about" aria-labelledby="about-heading">
  <h2 id="about-heading" class="visually-hidden">{about.heading}</h2>
  <dl class="facts">
    {about.facts.map((fact) => (
      <div>
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>
  <div>
    <p class="paragraph">{about.paragraph}</p>
    <dl class="skills">
      {about.skills.map((group) => (
        <div>
          <dt>{group.label}</dt>
          <dd>{group.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 34% 1fr; padding-top: clamp(120px, 12vw, 192px); }
  .facts { display: grid; gap: 20px; align-content: start; font-size: var(--step-small); }
  dt { color: var(--muted); }
  .paragraph { font-size: var(--step-lead); line-height: 1.35; max-width: 32ch; }
  .skills { margin-top: clamp(56px, 6vw, 88px); display: grid; grid-template-columns: repeat(2, minmax(0, 18rem)); gap: 28px 48px; }
  .skills dd { margin-top: 4px; }

  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; gap: 40px; }
    .about > div { order: -1; }
    .facts { grid-template-columns: 1fr 1fr; font-size: 15px; }
    .skills { grid-template-columns: 1fr; }
  }
</style>
