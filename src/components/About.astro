---
import type { CollectionEntry } from 'astro:content';

interface Props { site: CollectionEntry<'site'>['data'] }
const { about } = Astro.props.site;
---
<section class="section" id="about" aria-labelledby="about-heading">
  <h2 class="section-heading" id="about-heading">{about.heading}</h2>
  <div class="cols">
    <dl class="facts">
      {about.facts.map((fact) => (
        <div>
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
    <div>
      <p class="paragraph">{about.paragraph}</p>
      <dl class="skills">
        {about.skills.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items.join(', ')}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .facts { display: grid; gap: 20px; align-content: start; }
  dt { color: var(--muted); font-size: var(--step-small); }
  .paragraph { font-size: var(--step-lead); line-height: 1.35; }
  .skills { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 40px; }
  .skills dd { margin-top: 4px; }

  @media (max-width: 860px) {
    .facts { grid-template-columns: repeat(3, auto); justify-content: start; gap: 16px 32px; margin-bottom: 24px; }
  }
  @media (max-width: 560px) {
    .skills { grid-template-columns: 1fr; }
  }
</style>
