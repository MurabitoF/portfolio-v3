---
// Cloudflare Pages serves this with a real 404 status; without it, any unknown URL returned the home page with 200.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

const site = (await getEntry('site', 'en'))!.data;
const es = (await getEntry('site', 'es'))!.data;
---
<Base lang="en" title={`${site.notFound.title} · ${site.name}`} description={site.description} alternate={{ lang: 'es', href: '/es/' }}>
  <Header site={site} lang="en" />
  <main id="content" tabindex="-1" class="section not-found">
    <h1 class="section-heading">{site.notFound.title}</h1>
    <p>{site.notFound.text} <a href="/">{site.notFound.back}</a></p>
    <p lang="es">{es.notFound.text} <a href="/es/">{es.notFound.back}</a></p>
  </main>
</Base>

<style>
  .not-found { min-height: 70svh; display: grid; align-content: center; gap: 12px; }
  .not-found a { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
